---
import { capabilities, levelLabels, levelDescriptions } from '../data/capabilities';

const levelColors = ['var(--color-level-1)', 'var(--color-level-2)', 'var(--color-level-3)', 'var(--color-level-4)'];
---
<section class="my-16" aria-labelledby="heatmap-heading">
  <div class="mb-6">
    <h2 id="heatmap-heading" class="mb-2">Capability Heatmap</h2>
    <p class="text-[var(--color-text-muted)] max-w-3xl">
      Where I lead, design, and deliver. Four discrete levels — each tied to a specific kind of evidence, no false percentages.
    </p>
  </div>

  <!-- Legend -->
  <div class="mb-6 flex flex-wrap gap-4 text-sm">
    {[1,2,3,4].map((lvl) => (
      <div class="flex items-center gap-2">
        <span class="inline-block w-4 h-4 rounded border border-[var(--color-border)]" style={`background:${levelColors[lvl-1]}`}></span>
        <span class="text-[var(--color-text-muted)]">
          <strong class="text-[var(--color-text)] font-medium">{levelLabels[lvl as 1|2|3|4]}</strong>
          <span class="hidden sm:inline"> — {levelDescriptions[lvl as 1|2|3|4]}</span>
        </span>
      </div>
    ))}
  </div>

  <!-- Heatmap grid -->
  <div class="overflow-x-auto">
    <div class="min-w-[640px] border border-[var(--color-border)] rounded-lg overflow-hidden bg-[var(--color-surface)]">
      <!-- Header row -->
      <div class="grid grid-cols-[1fr,repeat(4,minmax(80px,1fr))] border-b border-[var(--color-border)] bg-[var(--color-surface-2)] text-xs font-mono uppercase text-[var(--color-text-subtle)]">
        <div class="px-4 py-3">Capability</div>
        {[1,2,3,4].map((lvl) => (
          <div class="px-2 py-3 text-center" title={levelDescriptions[lvl as 1|2|3|4]}>
            {levelLabels[lvl as 1|2|3|4]}
          </div>
        ))}
      </div>

      {capabilities.map((cap, idx) => (
        <div class:list={["grid grid-cols-[1fr,repeat(4,minmax(80px,1fr))] border-b border-[var(--color-border)] hover:bg-[var(--color-surface-2)]/40 transition-colors", idx === capabilities.length - 1 ? "border-b-0" : ""]}>
          <div class="px-4 py-3 text-sm">
            <div class="font-medium text-[var(--color-text)]">{cap.name}</div>
            <div class="text-xs text-[var(--color-text-muted)] mt-0.5 italic">{cap.evidence}</div>
          </div>
          {[1,2,3,4].map((lvl) => {
            const isActive = lvl === cap.level;
            return (
              <div class="px-2 py-3 flex items-center justify-center border-l border-[var(--color-border)]">
                {isActive ? (
                  <div
                    class="w-full h-8 rounded"
                    style={`background:${levelColors[lvl-1]}`}
                    title={`${cap.name}: ${levelLabels[lvl as 1|2|3|4]} — ${cap.evidence}`}
                    aria-label={`${cap.name}: ${levelLabels[lvl as 1|2|3|4]} — ${cap.evidence}`}
                  ></div>
                ) : (
                  <div class="w-full h-8 rounded bg-[var(--color-surface-2)] opacity-50"></div>
                )}
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>

  <p class="visual-caption">
    Heatmap showing 16 capabilities across 4 evidence-based levels. Hover or focus any active cell for the deliverable, role, or recognition that grounds the level.
  </p>
</section>
