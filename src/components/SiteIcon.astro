---
interface Props {
  name:
    | 'overview'
    | 'evidence'
    | 'cases'
    | 'timeline'
    | 'credentials'
    | 'contact'
    | 'linkedin'
    | 'github'
    | 'download'
    | 'arrow'
    | 'lock';
  size?: number;
  strokeWidth?: number;
}

const { name, size = 20, strokeWidth = 1.7 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class="site-icon"
>
  {name === 'overview' && (
    <>
      <path d="M4 20V10M10 20V4M16 20v-7M22 20V7" />
      <path d="M2 20h22" />
    </>
  )}
  {name === 'evidence' && (
    <>
      <path d="M4 19V9M10 19V5M16 19v-7M22 19V3" />
      <path d="m3 6 6-3 6 5 7-6" />
    </>
  )}
  {name === 'cases' && (
    <>
      <path d="M7 4h10l3 4v12H4V8z" />
      <path d="M9 4V2h6v2M4 10h16M10 13h4" />
    </>
  )}
  {name === 'timeline' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'credentials' && (
    <>
      <path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5z" />
      <path d="m9 12 2 2 4-5" />
    </>
  )}
  {name === 'contact' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'linkedin' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <path d="M8 10v7M8 7v.01M12 17v-4a3 3 0 0 1 6 0v4M12 10v7" />
    </>
  )}
  {name === 'github' && (
    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7.4A5.8 5.8 0 0 0 19.3 3 5.4 5.4 0 0 0 19 0s-1.2-.4-4 1.5a13.4 13.4 0 0 0-7 0C5.2-.4 4 0 4 0a5.4 5.4 0 0 0-.3 3A5.8 5.8 0 0 0 2.2 7.1c0 5.8 3.5 7 6.8 7.4a4.8 4.8 0 0 0-1 3.5v4M8 19c-3 .9-3-1.5-4.2-2" />
  )}
  {name === 'download' && (
    <>
      <path d="M12 3v12" />
      <path d="m7 10 5 5 5-5M5 21h14" />
    </>
  )}
  {name === 'arrow' && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === 'lock' && (
    <>
      <rect x="5" y="10" width="14" height="11" rx="2" />
      <path d="M8 10V7a4 4 0 0 1 8 0v3" />
    </>
  )}
</svg>
