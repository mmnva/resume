---
import { projects, domainMeta } from '../data/projects';

// Layout constants
const W = 720;
const H = 460;
const PAD = { top: 40, right: 40, bottom: 60, left: 70 };
const innerW = W - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;

// Map project (scope, impact) to (x, y). scope 1..3 → x, impact 1..3 → y (inverted)
const xFor = (scope: number) => PAD.left + ((scope - 0.5) / 3) * innerW;
const yFor = (impact: number) => PAD.top + innerH - ((impact - 0.5) / 3) * innerH;
const rFor = (size: number) => 6 + size * 5; // 11, 16, 21

const domainColors: Record<string, string> = {
  legal: '#1e40af',
  data: '#15803d',
  ppm: '#7e22ce',
  ai: '#c2410c',
};
---
<section class="my-16" aria-labelledby="scatterplot-heading">
  <div class="mb-6">
    <h2 id="scatterplot-heading" class="mb-2">Project Impact Scatterplot</h2>
    <p class="text-[var(--color-text-muted)] max-w-3xl">
      What I have actually delivered. Each dot is a project — positioned by scope and impact, with the business outcome in the label.
    </p>
  </div>

  <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg p-4 overflow-x-auto">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="scatterplot-heading" class="w-full h-auto max-w-full" style="min-width: 600px;">
      <!-- Gridlines -->
      <g>
        {[1,2,3].map(g => (
          <>
            <line x1={xFor(g)} y1={PAD.top} x2={xFor(g)} y2={PAD.top + innerH} stroke="var(--color-border)" stroke-width="1" />
            <line x1={PAD.left} y1={yFor(g)} x2={PAD.left + innerW} y2={yFor(g)} stroke="var(--color-border)" stroke-width="1" />
          </>
        ))}
      </g>

      <!-- Axes -->
      <line x1={PAD.left} y1={PAD.top} x2={PAD.left} y2={PAD.top + innerH} stroke="var(--color-text-muted)" stroke-width="1.5" />
      <line x1={PAD.left} y1={PAD.top + innerH} x2={PAD.left + innerW} y2={PAD.top + innerH} stroke="var(--color-text-muted)" stroke-width="1.5" />

      <!-- X axis ticks/labels -->
      <g font-family="ui-monospace, monospace" font-size="11" fill="var(--color-text-subtle)" text-anchor="middle">
        {[1,2,3].map(g => (
          <>
            <line x1={xFor(g)} y1={PAD.top + innerH} x2={xFor(g)} y2={PAD.top + innerH + 4} stroke="var(--color-text-muted)" />
            <text x={xFor(g)} y={PAD.top + innerH + 18}>low</text>
            <text x={xFor(g)} y={PAD.top + innerH + 32}>{g === 1 ? "single" : g === 2 ? "cross-team" : "enterprise"}</text>
          </>
        ))}
      </g>

      <!-- Y axis ticks/labels -->
      <g font-family="ui-monospace, monospace" font-size="11" fill="var(--color-text-subtle)" text-anchor="end">
        {[1,2,3].map(g => (
          <>
            <line x1={PAD.left - 4} y1={yFor(g)} x2={PAD.left} y2={yFor(g)} stroke="var(--color-text-muted)" />
            <text x={PAD.left - 8} y={yFor(g) + 4}>{g === 1 ? "low (<10%)" : g === 2 ? "measurable" : "high (>50% / $1M+)"}</text>
          </>
        ))}
      </g>

      <!-- Axis titles -->
      <text x={PAD.left + innerW / 2} y={H - 8} font-family="ui-monospace, monospace" font-size="11" fill="var(--color-text-muted)" text-anchor="middle" letter-spacing="0.05em">
        COMPLEXITY / SCOPE →
      </text>
      <text x={16} y={PAD.top + innerH / 2} font-family="ui-monospace, monospace" font-size="11" fill="var(--color-text-muted)" text-anchor="middle" letter-spacing="0.05em" transform={`rotate(-90, 16, ${PAD.top + innerH / 2})`}>
        ← BUSINESS IMPACT
      </text>

      <!-- Dots -->
      {projects.map(p => {
        const cx = xFor(p.scope);
        const cy = yFor(p.impact);
        const r = rFor(p.size);
        return (
          <a href={p.href} aria-label={`${p.label} — open case study`}>
            <circle
              cx={cx}
              cy={cy}
              r={r}
              fill={domainColors[p.domain]}
              fill-opacity="0.65"
              stroke={domainColors[p.domain]}
              stroke-width="2"
              class="transition-all hover:fill-opacity-0.9 cursor-pointer"
            />
            <text
              x={cx}
              y={cy + r + 12}
              font-size="10"
              fill="var(--color-text)"
              text-anchor="middle"
              class="pointer-events-none"
              style="font-family: var(--font-body); font-weight: 500;"
            >
              {p.shortLabel}
            </text>
          </a>
        );
      })}
    </svg>
  </div>

  <!-- Domain legend -->
  <div class="mt-4 flex flex-wrap gap-4 text-xs">
    {Object.entries(domainMeta).map(([k, m]) => (
      <div class="flex items-center gap-2">
        <span class="inline-block w-3 h-3 rounded-full" style={`background:${m.color}`}></span>
        <span class="text-[var(--color-text-muted)]">{m.label}</span>
      </div>
    ))}
    <div class="flex items-center gap-2 text-[var(--color-text-subtle)]">
      <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-text-subtle)]"></span>
      <span class="w-3 h-3 rounded-full bg-[var(--color-text-subtle)]"></span>
      <span class="inline-block w-4 h-4 rounded-full bg-[var(--color-text-subtle)]"></span>
      <span class="ml-1">bubble = scope (# stakeholders / systems)</span>
    </div>
  </div>

  <p class="visual-caption">
    10 representative projects plotted by complexity/scope (X) and quantified business impact (Y). Bubble size = breadth (stakeholders/systems). Color = domain. Click any dot for the case study.
  </p>
</section>
