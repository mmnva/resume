---
import { featuredCases } from '../data/portfolio.mjs';
---

<section id="case-studies" class="portfolio-section" aria-labelledby="case-studies-heading">
  <div class="section-heading">
    <p class="section-label">Featured case studies</p>
    <h2 id="case-studies-heading">Three programs. Clear business evidence.</h2>
  </div>

  <div class="case-grid">
    {featuredCases.map((item) => (
      <article class="case-card">
        <p class="case-track">{item.track}</p>
        <h3>{item.title}</h3>
        <p class="case-meta">{item.company} · {item.period}</p>
        <p class="case-outcome">{item.outcome}</p>
        <details>
          <summary>View case evidence</summary>
          <div class="case-detail">
            <p><strong>Business problem</strong>{item.problem}</p>
            <p><strong>Intervention</strong>{item.intervention}</p>
          </div>
        </details>
      </article>
    ))}
  </div>
</section>
