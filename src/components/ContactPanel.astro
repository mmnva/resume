---
import SiteIcon from './SiteIcon.astro';
---

<section id="contact" class="portfolio-section contact-panel" aria-labelledby="contact-heading">
  <div class="contact-intro">
    <p class="section-label">Let's connect</p>
    <h2 id="contact-heading">Have a complex system to make clearer?</h2>
    <p>
      Share the role, program, or operating challenge. Your message goes directly to a
      private inbox through this site's Cloudflare-native contact path.
    </p>
    <a href="https://linkedin.com/in/michaelemcnea" target="_blank" rel="noreferrer">
      Prefer LinkedIn? Connect there <span aria-hidden="true">↗</span>
    </a>
  </div>

  <form class="contact-form" action="/api/contact" method="post" data-contact-form>
    <div class="contact-fields">
      <label>
        Name
        <input name="name" autocomplete="name" maxlength="80" required />
      </label>
      <label>
        Reply email
        <input type="email" name="email" autocomplete="email" maxlength="160" required />
      </label>
    </div>
    <label>
      Company or role <span>(optional)</span>
      <input name="company" autocomplete="organization" maxlength="120" />
    </label>
    <label>
      Message
      <textarea name="message" rows="5" maxlength="3000" required></textarea>
    </label>
    <label class="honeypot" aria-hidden="true">
      Website
      <input name="website" tabindex="-1" autocomplete="off" />
    </label>
    <button class="button button-primary" type="submit">Send a private message</button>
    <p class="form-privacy"><SiteIcon name="lock" size={16} /> Sent directly. Not stored by this site.</p>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>
  </form>
</section>

<script>
  const form = document.querySelector('[data-contact-form]');
  const status = form?.querySelector('[data-form-status]');
  const submit = form?.querySelector('button[type="submit"]');
  const result = new URLSearchParams(window.location.search).get('contact');

  if (status && result === 'sent') {
    status.textContent = 'Message sent. Thank you — I will reply directly.';
  } else if (status && result === 'error') {
    status.textContent = 'The message could not be sent. Please try again or use LinkedIn.';
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(submit instanceof HTMLButtonElement) || !status) return;

    submit.disabled = true;
    status.textContent = 'Sending…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const payload = await response.json();

      if (!response.ok) throw new Error(payload?.error ?? 'Unable to send');

      form.reset();
      status.textContent = 'Message sent. Thank you — I will reply directly.';
    } catch {
      status.textContent = 'The message could not be sent. Please try again or use LinkedIn.';
    } finally {
      submit.disabled = false;
    }
  });
</script>
