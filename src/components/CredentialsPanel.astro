---
import SiteIcon from './SiteIcon.astro';
import { credentials, technologyGroups } from '../data/portfolio.mjs';
---

<section id="credentials" class="portfolio-section credentials-section" aria-labelledby="credentials-heading">
  <div class="section-heading">
    <p class="section-label">Credentials and technology</p>
    <h2 id="credentials-heading">Proven practice, supported by the right platforms.</h2>
  </div>

  <div class="credentials-layout">
    <div class="credential-list" aria-label="Professional credentials">
      {credentials.map((credential) => (
        <article class="credential-card">
          <span class="credential-icon"><SiteIcon name="credentials" size={22} /></span>
          <div>
            <h3>{credential.name}</h3>
            <p>{credential.detail}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="technology-groups" aria-label="Technology groups">
      {technologyGroups.map((group) => (
        <article>
          <h3>{group.name}</h3>
          <p>{group.items.join(' · ')}</p>
        </article>
      ))}
    </div>
  </div>
</section>
