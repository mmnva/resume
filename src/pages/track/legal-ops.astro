---
import TrackLayout from '../../layouts/TrackLayout.astro';

const title = "Legal Operations";
const tagline = "8+ years legal tech · CLM, eBilling, Matter Management · AI-driven automation";
const description = "Michael McNea — Legal Operations & Technology track. CLM, eBilling, Matter Management, AI doc automation, FHFA-regulated work at Freddie Mac Legal Division.";

const summary = "Legal Operations & Technology Leader with 8+ years of progressive legal technology experience and 15+ years transforming enterprise operations. Currently serving as CDO Delegate for Freddie Mac's Legal Division. At Micron, managed a 2-person team and $1.25M legal technology portfolio while evaluating enterprise CLM platforms (Conga, Evisort, Agiloft, Ironclad) and eBilling systems (Mitratech TeamConnect, Brightflag). Expertise in legal workflow automation, matter management, vendor negotiations, and delivering measurable operational improvements through technology innovation and AI-driven solutions.";

const impact = [
  { metric: "300%", label: "faster iManage migration via AI doc classifier" },
  { metric: "60%", label: "cycle time cut on annual records review" },
  { metric: "$50K+", label: "saved by replacing CLM license with Power Platform NDA tool" },
  { metric: "$1.25M", label: "12-system legal tech portfolio owned at Micron" },
  { metric: "4", label: "CLM/eBilling platforms evaluated via hands-on POCs" },
  { metric: "$3T", label: "GSE Legal Division (CDO Delegate) under FHFA oversight" },
];

const timeline = [
  { role: "Enterprise Data Strategy & Governance Manager — CDO Delegate, Legal Division", company: "Freddie Mac", period: "Jun 2024 – Present", detail: "Serve as CDO delegate for the Legal Division of a $3T mortgage-finance GSE operating under FHFA regulatory oversight. Maintain enterprise-wide data governance framework aligned to FHFA and DAMA-DMBOK; lead Tier 2 data lineage and CDE program in Collibra." },
  { role: "Strategic Portfolio Manager, Legal Technology", company: "Micron Technology", period: "Jan 2023 – Jun 2024", detail: "Managed 12-system, $1.25M legal technology portfolio. Led CLM/eBilling platform evaluations (Conga, Ironclad, Agiloft, Evisort, Mitratech TeamConnect, Brightflag) with hands-on POCs. Co-developed 3-year legal tech roadmap with GC." },
  { role: "Senior Program Manager, Information Governance", company: "Micron Technology", period: "Jan 2021 – Jan 2023", detail: "Directed enterprise-wide Information Governance initiative and Microsoft Purview Records Management deployment planning. Led Records & Information Management vendor evaluation (AvePoint, Valora, RecordPoint). Negotiated global offsite storage contracts." },
];

const tech = {
  "CLM platforms": ["Conga", "Ironclad", "Agiloft", "Evisort AI", "iCertis", "Malbek", "LinkSquares"],
  "Matter Mgmt / eBilling": ["Mitratech TeamConnect", "Brightflag", "Thomson Reuters Legal Tracker", "Wolters Kluwer", "Onit"],
  "Records & Doc Mgmt": ["Microsoft Purview", "iManage", "RecordPoint", "Valora", "AvePoint", "Documentum", "SharePoint"],
  "Data & Analytics": ["Collibra", "ASG Data Intelligence", "Tableau", "Power BI", "SQL", "Power Query", "Excel (Advanced)"],
  "Automation & Dev": ["Python", "Power Platform (Power Apps, Power Automate)", "Atlassian (Jira, Confluence)", "LUMA HCD", "Mural", "Visio"],
};

const certs = [
  "LUMA Practitioner — Human-Centered Design",
  "Agentic AI Governance — Dataversity",
  "Enterprise Content Management (ECM) Fundamentals",
  "PMI Project Management Professional Course",
  "APICS Certified Supply Chain Professional (CSCP) — 2008",
  "Certified Data Management Professional (CDMP) — expected Jan 2026",
];

const caseStudies = ["legal-tech-portfolio", "nda-self-service", "clm-platform-evaluation", "ai-doc-classifier"];
const foundationNote = "Foundation: 15+ years IT, procurement, and process excellence at Micron, Perot Systems, Spacelink, and Veridian. Full timeline on the home page.";
---
<TrackLayout
  title={title}
  tagline={tagline}
  summary={summary}
  impact={impact}
  timeline={timeline}
  tech={tech}
  certs={certs}
  caseStudies={caseStudies}
  domainColor="var(--color-legal)"
  domainLabel="Legal Ops"
  description={description}
  foundationNote={foundationNote}
/>
