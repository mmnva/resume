---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerStrip from '../components/CareerStrip.astro';
import ContactPanel from '../components/ContactPanel.astro';
import CredentialsPanel from '../components/CredentialsPanel.astro';
import EvidenceDesk from '../components/EvidenceDesk.astro';
import FeaturedCases from '../components/FeaturedCases.astro';
import IdentityRail from '../components/IdentityRail.astro';
import SiteIcon from '../components/SiteIcon.astro';
import portrait from '../assets/michael-mcnea-portrait.jpeg';

const description =
  'Michael McNea, CDMP — source-backed outcomes across data governance, legal technology, legal operations, and enterprise program leadership.';
---

<BaseLayout title="Michael McNea" description={description} ogImage={portrait.src}>
  <div class="site-shell">
    <IdentityRail />

    <div class="evidence-canvas">
      <section id="overview" class="hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <h1 id="page-title">Michael McNea, CDMP</h1>
          <p class="hero-tracks">Data Governance · Legal Technology · Legal Operations</p>
          <span class="hero-rule" aria-hidden="true"></span>
          <p class="hero-statement">
            I design systems, align stakeholders, and deliver measurable outcomes at the
            intersection of data, technology, and the business of law.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#evidence">
              View Evidence
              <SiteIcon name="arrow" size={18} />
            </a>
          </div>
        </div>

        <p class="hero-aside">
          I make work simpler<br />
          for the people I work with,<br />
          always with an eye on what's next.
        </p>
      </section>

      <EvidenceDesk />
      <FeaturedCases />
      <CareerStrip />
      <CredentialsPanel />
      <ContactPanel />
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Michael McNea</p>
        <p>Built with Astro · Hosted on Cloudflare</p>
      </footer>
    </div>
  </div>
</BaseLayout>
